# BlockCert AI environment configuration
# Copy to .env and fill in real values. No secrets are committed to Git.

# HTTP server
PORT=5000

# Public base URL used in QR codes and share links (no trailing slash)
BASE_URL=http://localhost:5000

# PostgreSQL connection string (required for all data operations)
DATABASE_URL=postgres://user:password@localhost:5432/blockcert

# Auth (required). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Blockchain (EVM RPC, e.g. Ganache at http://127.0.0.1:7545)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
# Server-side issuer account private key. NEVER expose to the frontend.
BLOCKCHAIN_PRIVATE_KEY=
# Deployed CertificateRegistry address (output of: npm run contract:deploy)
CONTRACT_ADDRESS=

# AI provider (OpenAI-compatible chat completions API)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# AI risk thresholds (0-100). Inclusive lower bound.
AI_RISK_SUSPICIOUS_THRESHOLD=31
AI_RISK_TAMPERED_THRESHOLD=71

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# CORS (comma separated origins). Leave empty to allow same-origin only.
CORS_ORIGIN=
